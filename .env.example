# Example environment variables for QuantumID (DO NOT commit real secrets)

# Database - defaults to SQLite in `backend/database.py` if unset
# Use a Postgres URL in production, for example:
# DATABASE_URL=postgresql://postgres:password@db:5432/quantumid
DATABASE_URL=sqlite:///./quantumid.db

# TextBee (SMS)
TEXTBEE_API_KEY=your_textbee_api_key_here
TEXTBEE_DEVICE_ID=your_textbee_device_id_here
TEXTBEE_BASE_URL=https://api.textbee.dev/api/v1/gateway

# Email provider (example)
BREVO_API_KEY=your_brevo_api_key_here
FROM_EMAIL=sender@example.com

# Application secrets
SECRET_KEY=replace_with_a_secure_random_value
JWT_SECRET=replace_with_a_jwt_secret

# Optional alert/test settings
ALERT_PHONE=+10000000000
ALERT_EMAIL=alerts@example.com
